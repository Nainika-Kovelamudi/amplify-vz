# Copy to .env.local for local development.

# ── Amplify FastAPI Backend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
# Production: VITE_API_URL=https://api.amplify.infovision.com

# ── Microsoft Entra ID (MSAL.js — replaces Supabase Azure OAuth) ────────────
# Azure Portal → App Registrations → your app
VITE_AZURE_TENANT_ID=<your-tenant-id>
VITE_AZURE_CLIENT_ID=<your-app-registration-client-id>

# SPA Redirect URIs to configure in Azure Portal → Authentication:
#   http://localhost:5173/auth/callback
#   https://amplify.infovision.com/auth/callback

# ── ArchEval Feature (keep — separate self-contained Supabase project) ───────
# VITE_ARCHEVAL_SUPABASE_URL=
# VITE_ARCHEVAL_SUPABASE_KEY=
# VITE_ARCHEVAL_TABLE=archeval_submissions
# VITE_ARCHEVAL_LEGACY_TABLE=submissions

# ── Removed (handled by backend now) ────────────────────────────────────────
# VITE_SUPABASE_URL            → backend uses PostgreSQL directly
# VITE_SUPABASE_PUBLISHABLE_KEY → not needed
# VITE_FIREBASE_*               → media upload now via POST /media/upload
# VITE_GEMINI_API_KEY           → Gemini called server-side in scoring pipeline

# Pipeline Asset Operations tab (frontend build-time flag; hidden by default)
VITE_ASSET_OPERATIONS_ENABLED=false
